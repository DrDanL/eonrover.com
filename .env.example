# Copy this file to .env before running `docker compose up --build`.
# This template configures local development only. It is not a production
# environment template, and none of the values below are real secrets.

# --- Database -----------------------------------------------------------
POSTGRES_USER=eonrover
POSTGRES_PASSWORD=eonrover_dev_password
POSTGRES_DB=eonrover
# DATABASE_URL is assembled automatically in docker-compose.yml from the
# POSTGRES_* values above. API and worker processes started directly require an
# exported DATABASE_URL using postgres: or postgresql: and a localhost host.

# --- Automated database tests --------------------------------------------
# These values are for tests run from the host, not for the application
# containers. Test commands do not load .env automatically: export them in the
# test shell. The reset opt-in is deliberately disabled in the example.
TEST_DATABASE_URL=postgresql://eonrover:eonrover_dev_password@localhost:5432/eonrover_test
ALLOW_TEST_DATABASE_RESET=0

# --- Redis / queues -------------------------------------------------------
# Compose uses its Redis service hostname. Direct local processes should export
# REDIS_URL=redis://localhost:6379 instead.
REDIS_URL=redis://redis:6379

# --- API ------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Public URL of the web app, used for CORS and for links inside emails.
WEB_URL=http://localhost:3000
# Local HTTP development needs non-secure cookies. Production requires true.
COOKIE_SECURE=false

# --- Worker -----------------------------------------------------------------
WORKER_HEALTH_PORT=4100

# --- Outbound email (Mailpit in local/dev) --------------------------------
# Production must explicitly provide a non-local SMTP host, port, and sender.
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=no-reply@eonrover.com

# --- Web frontend -----------------------------------------------------------
# Browser-facing URL of the API. When running via docker compose on your own
# machine this stays as localhost because it is baked into the browser bundle.
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Development administrator ---------------------------------------------
# A single admin account is created on first boot from these values. Leave any
# of them blank to skip creating an administrator.
ADMIN_EMAIL=admin@eonrover.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

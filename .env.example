# Copy this file to .env before running `docker compose up --build`.
# None of the values below are real secrets - replace them for any shared or
# production-like environment.

# --- Database -----------------------------------------------------------
POSTGRES_USER=eonrover
POSTGRES_PASSWORD=eonrover_dev_password
POSTGRES_DB=eonrover
# DATABASE_URL is assembled automatically in docker-compose.yml from the
# POSTGRES_* values above so no credentials need to be duplicated here.

# --- Redis / queues -------------------------------------------------------
REDIS_URL=redis://redis:6379

# --- API ------------------------------------------------------------------
PORT=4000
NODE_ENV=production
# Public URL of the web app, used for CORS and for links inside emails.
WEB_URL=http://localhost:3000
# Set to "false" to allow non-HTTPS cookies in local development (already the
# default outside of NODE_ENV=production).
COOKIE_SECURE=false

# --- Worker -----------------------------------------------------------------
WORKER_HEALTH_PORT=4100

# --- Outbound email (Mailpit in local/dev) --------------------------------
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=no-reply@eonrover.com

# --- Web frontend -----------------------------------------------------------
# Browser-facing URL of the API. When running via docker compose on your own
# machine this stays as localhost because it is baked into the browser bundle.
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Development administrator ---------------------------------------------
# A single admin account is created on first boot from these values. Leave any
# of them blank to skip creating an administrator.
ADMIN_EMAIL=admin@eonrover.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
